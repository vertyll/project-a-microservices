{
  "type": "record",
  "name": "SagaCompensationEvent",
  "namespace": "com.vertyll.veds.task.saga",
  "doc": "Internal compensation event for task-service. A tagged union of typed actions, so values keep their domain meaning end-to-end rather than degrading to a map<string>.",
  "fields": [
    {
      "name": "sagaId",
      "type": "string"
    },
    {
      "name": "stepId",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "action",
      "type": [
        {
          "type": "record",
          "name": "DeleteTaskAction",
          "doc": "Undoes a task creation whose later step failed.",
          "fields": [
            {
              "name": "taskId",
              "type": "string"
            }
          ]
        },
        {
          "type": "record",
          "name": "LogTaskCompensationAction",
          "doc": "Records that a step needed no state change to undo.",
          "fields": [
            {
              "name": "taskId",
              "type": "string"
            }
          ]
        }
      ]
    }
  ]
}
