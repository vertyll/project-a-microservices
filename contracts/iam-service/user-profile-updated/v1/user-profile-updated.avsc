{
  "type": "record",
  "name": "UserProfileUpdatedEvent",
  "namespace": "com.vertyll.veds.iam",
  "doc": "Published when a user's displayable profile changes. Carries the full profile rather than a delta, so a consumer that missed an earlier event still converges on the right state.",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "userId",
      "type": "string"
    },
    {
      "name": "email",
      "type": "string"
    },
    {
      "name": "firstName",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "lastName",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "avatarFileId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    }
  ]
}
