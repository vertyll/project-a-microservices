{
  "type": "record",
  "name": "ProjectCategoryChangedEvent",
  "namespace": "com.vertyll.veds.project",
  "doc": "Published on any category create/update/delete so task-service can refresh its read model.",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "projectId",
      "type": "string"
    },
    {
      "name": "categoryId",
      "type": "string"
    },
    {
      "name": "names",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Label per supported language, keyed by language code (PL, EN)."
    },
    {
      "name": "color",
      "type": "string"
    },
    {
      "name": "removed",
      "type": "boolean",
      "default": false
    }
  ]
}
