{
  "type": "record",
  "name": "SagaCompensationEvent",
  "namespace": "com.vertyll.veds.notification.saga",
  "doc": "Internal compensation event published by notification-service to the saga-compensation-notification topic. The 'action' field is a tagged union of typed compensation actions — each variant carries the data needed by NotificationCompensationService. No untyped 'extraPayload: map<string>' is used so values keep their domain types end-to-end. Mirrors the sealed NotificationCompensationCommand hierarchy in the application layer.",
  "fields": [
    { "name": "sagaId", "type": "string" },
    { "name": "stepId", "type": ["null", "long"], "default": null },
    {
      "name": "action",
      "type": [
        {
          "type": "record",
          "name": "DeleteNotificationAction",
          "doc": "Compensates PersistNotification step — deletes the local notification aggregate that the failed flow created.",
          "fields": [
            { "name": "notificationId", "type": "string" }
          ]
        },
        {
          "type": "record",
          "name": "LogNotificationCompensationAction",
          "doc": "Compensates PublishNotificationEvent step — the published Kafka event cannot be un-published, so the compensation only records a log entry (kept as a placeholder for clone-time replacement).",
          "fields": [
            { "name": "notificationId", "type": "string" }
          ]
        }
      ]
    }
  ]
}
